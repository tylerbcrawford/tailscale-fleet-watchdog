# Tailscale OAuth client for bin/tailscale-fleet-audit.sh
# Create one at https://login.tailscale.com/admin/settings/oauth with scope: devices:read
# Save as ~/.config/tailscale-fleet-watchdog/credentials.env and chmod 600.

TS_OAUTH_CLIENT_ID=""
TS_OAUTH_CLIENT_SECRET=""
TS_TAILNET="-"   # "-" = the tailnet that owns the OAuth client (almost always what you want)
